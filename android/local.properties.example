sdk.dir=/absolute/path/to/Android/sdk
# Default personal build: feed reader only; no Firebase configuration is needed.
robin.enableAi=false
# To opt into fact checking, set true and supply your own app/google-services.json.
# Configure Firebase App Check enforcement, key restrictions and service quotas first.
# Both Debug and Release use Play Integrity; no debug attestation bypass is supported.
# Debug-only benchmark controls; Release always disables them.
robin.showDebugSettings=true
